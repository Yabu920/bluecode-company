# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_random_secret

# Demo credentials for the Credentials provider (change or remove for production)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=changeme

# Google service account JSON (compact JSON string). If not set, API endpoints return sample data.
# Example (single-line JSON):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Google Analytics property and Search Console site
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID
SEARCH_CONSOLE_SITE=https://your-site.com

# Database (Postgres) connection string for Prisma. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="mysql://root:Yeab920%40.com@localhost:3306/bluecode"

# SMTP settings for contact emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=webmaster@your-site.com
CONTACT_RECEIVER_EMAIL=you@your-site.com

# Uploads will be stored in `public/uploads` by default
